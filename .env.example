# Local password typed into the workbench. At least 16 characters.
# This is not your NovelAI token, and it is never written into the page HTML.
ACCESS_KEY=

# Persistent token from your own NovelAI account settings.
# Stays on this machine. The browser never receives it.
NAI_TOKEN=

# Official /image build you captured yourself. This repository does not include it.
# MIRROR_DIR=./mirror/nai-app

# Loopback only unless you also set ALLOW_LAN=1.
# BIND=127.0.0.1:8787

# Where generation requests are sent. Use the default, or your own compatible server.
# Plain http is accepted only for 127.0.0.1 / localhost.
# NAI_IMAGE_HOST=https://image.novelai.net
# NAI_API_HOST=https://api.novelai.net

# ALLOW_LAN=1
